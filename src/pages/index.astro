---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/profile/Passport.png";
import { site } from "../data/site.js";
---

<BaseLayout>
  <section class="hero container">
    <div class="text">
      <h1>{site.name}</h1>
      <p class="role">Statistician | Data Analyst | Data Scientist</p>

      <p class="intro">
        I’m a statistician who enjoys making sense of messy data and turning it
        into something useful. I’ve worked across credit analysis, institutional
        research, and machine learning, using Python, SQL, Power BI, and R along
        the way. What interests me most is digging into a problem, understanding
        what the data is saying, and finding a practical way forward.
      </p>

      <p class="actions">
        <a class="button" href={site.cv} target="_blank" rel="noopener noreferrer">
          Download CV
        </a>

        <a class="icon-link" href={`mailto:${site.email}`} aria-label="Email me">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1.4 2 7.1 6.2a1 1 0 0 0 1 0L19.6 7H4.4ZM4 8.2V17h16V8.2l-6.9 6a2 2 0 0 1-2.2 0L4 8.2Z"/></svg>
        </a>

        <a class="icon-link" href={site.github} aria-label="GitHub profile">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.93 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.45 9.45 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.83-2.34 4.68-4.57 4.92.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
        </a>

        <a class="icon-link" href={site.linkedin} aria-label="LinkedIn profile">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM3.2 8.75h3.5V21H3.2V8.75Zm6.35 0h3.36v1.68h.05c.47-.87 1.6-1.79 3.3-1.79 3.53 0 4.18 2.28 4.18 5.25V21h-3.5v-5.57c0-1.33-.02-3.04-1.86-3.04-1.87 0-2.15 1.44-2.15 2.94V21H9.55V8.75Z"/></svg>
        </a>
      </p>
    </div>

    <Image
      class="portrait"
      src={portrait}
      alt="Portrait of Michael Nyawade"
      width={220}
      height={220}
      format="webp"
      quality={80}
      loading="eager"
    />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.75rem;
    padding-block: clamp(2.5rem, 8vw, 5rem);
  }

  .text {
    order: 2;
  }

  .portrait {
    order: 1;
  }

  h1 {
    font-size: clamp(1.8rem, 9vw, 4rem);
    white-space: nowrap;
  }

  .role {
    font-size: 1.35rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .intro {
    margin-inline: auto;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 1.75rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--text);
  }

  .icon-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .icon-link svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .portrait {
    width: 12rem;
    height: 12rem;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--line);
  }

  @media (min-width: 40rem) {
    .hero {
      grid-template-columns: 1fr auto;
      justify-items: start;
      text-align: left;
    }

    .text {
      order: 1;
    }

    .portrait {
      order: 2;
    }

    .intro {
      margin-inline: 0;
    }

    .actions {
      justify-content: flex-start;
    }
  }
</style>