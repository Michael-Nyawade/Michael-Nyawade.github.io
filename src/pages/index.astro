---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import IconLink from "../components/IconLink.astro";
import portrait from "../assets/profile/Passport.png";
import { site } from "../data/site.js";
---

<BaseLayout>
  <section class="hero container">
    <div class="text">
      <h1>{site.name}</h1>
      <p class="role">Statistics | Data Analysis | Data Science</p>

      <p class="intro">
        I’m a statistician who enjoys making sense of messy data and turning
        it into something useful. I’ve worked across credit analysis,
        institutional research, and machine learning, using Python, SQL,
        Power BI, and R along the way. What interests me most is digging
        into a problem, understanding what the data is saying, and finding
        a practical way forward.
      </p>

      <p class="actions">
        <a class="button" href={site.cv} target="_blank" rel="noopener noreferrer">
          Download CV
        </a>

        <IconLink href={`mailto:${site.email}`} label="Email me" icon="email" newTab={false} />
        <IconLink href={site.whatsapp} label="Message me on WhatsApp" icon="whatsapp" />
        <IconLink href={site.github} label="GitHub profile" icon="github" />
        <IconLink href={site.linkedin} label="LinkedIn profile" icon="linkedin" />
      </p>
    </div>

    <Image
      class="portrait"
      src={portrait}
      alt="Portrait of Michael Nyawade"
      width={320}
      height={320}
      fit="cover"
      position="top"
      format="webp"
      quality={80}
      loading="eager"
    />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.75rem;
    padding-block: clamp(2.5rem, 8vw, 5rem);
  }

  .text {
    order: 2;
  }

  .portrait {
    order: 1;
  }

  h1 {
    font-size: clamp(1.8rem, 9vw, 4rem);
    white-space: nowrap;
  }

  .role {
    font-size: 1.35rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .intro {
    margin-inline: auto;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 1.75rem;
  }

  .portrait {
    width: clamp(12.5rem, 20vw, 16.25rem);
    height: clamp(12.5rem, 20vw, 16.25rem);
    object-fit: cover;
    object-position: top;
    border-radius: 50%;
    border: 1px solid var(--line);
  }

  @media (min-width: 40rem) {
    .hero {
      grid-template-columns: 1fr auto;
      justify-items: start;
      text-align: left;
    }

    .text {
      order: 1;
    }

    .portrait {
      order: 2;
    }

    .intro {
      margin-inline: 0;
    }

    .actions {
      justify-content: flex-start;
    }
  }
</style>
