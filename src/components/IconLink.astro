const { href, label, icon, newTab = true } = Astro.props;
---

<a
  class="icon-link"
  href={href}
  aria-label={label}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[icon]} /></svg>
</a>

<style>
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--text);
  }

  .icon-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .icon-link svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }
</style>
